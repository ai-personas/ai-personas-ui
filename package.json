{
  "name": "ai-personas-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "contract": "node scripts/contract.mjs",
    "test": "node --experimental-strip-types --test tests/workspace.test.mjs tests/api.test.mjs tests/presentation.test.mjs tests/identity.test.mjs tests/files.test.mjs",
    "test:identity": "node tests/identity.browser.mjs",
    "test:workspace": "node tests/workspace.browser.mjs && node tests/design-first.browser.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:files": "node tests/files.browser.mjs",
    "test:live": "node tests/live.mjs",
    "test:operator": "node tests/operator.browser.mjs",
    "test:activity": "node tests/activity.browser.mjs",
    "test:settings": "node tests/settings.browser.mjs",
    "test:forms": "node tests/forms.browser.mjs",
    "test:participants": "node tests/participants.browser.mjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.17.0",
    "dompurify": "3.4.15",
    "hash-wasm": "^4.12.0",
    "marked": "18.0.13",
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^22.0.0",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
